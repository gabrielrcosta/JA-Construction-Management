{
  "expo": {
    "name": "JA Construction",
    "slug": "ja-construction",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1012"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jaconstruction.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1012"
      },
      "package": "com.jaconstruction.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow JA Construction to access your camera to upload receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow JA Construction to access your photos to upload receipts."
        }
      ]
    ],
    "scheme": "ja-construction",
    "experiments": {
      "typedRoutes": true
    }
  }
}
